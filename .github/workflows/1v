# Publishes the game to GitHub Pages on every push to main.
# One-time setup: Settings > Pages > Build and deployment > Source = GitHub Actions.
# No secrets required: the site is a static HTML file generated by build.sh.
name: Pages
on:
  push:
    branches: [main]
  workflow_dispatch:

permissions:
  contents: read
  pages: write
  id-token: write

concurrency:
  group: pages
  cancel-in-progress: true

jobs:
  build:
    runs-on: ubuntu-latest
    timeout-minutes: 10
    steps:
      - uses: actions/checkout@v7

      - name: Build the site (single-file HTML + embedded models)
        run: LL_COPY_PARENT=0 sh build.sh && node --check dist/bundle.js && test -s dist/site/index.html

      - uses: actions/configure-pages@v6
      - uses: actions/upload-pages-artifact@v3
        with:
          path: dist/site

  deploy:
    needs: build
    runs-on: ubuntu-latest
    environment:
      name: github-pages
      url: ${{ steps.deployment.outputs.page_url }}
    steps:
      - id: deployment
        uses: actions/deploy-pages@v5
